rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function validTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validRecord(data) {
      return data.keys().hasOnly([
        'id', 'platform', 'date', 'startTime', 'endTime', 'totalHours',
        'passengerHours', 'passengerDistanceKm', 'emptyDistanceKm',
        'occupancyRatePct', 'grossEarnings', 'tips', 'bonuses',
        'tollsReimbursed', 'distanceKm', 'tripsCount', 'trips',
        'fuelCost', 'fuelExpenses', 'commissionCost', 'commissionPct',
        'taxCost', 'taxPct', 'otherExpenses',
        'netEarnings', 'hourlySegments', 'notes', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasAll([
        'id', 'platform', 'date', 'startTime', 'endTime', 'totalHours',
        'passengerHours', 'passengerDistanceKm', 'emptyDistanceKm',
        'occupancyRatePct', 'grossEarnings', 'tips', 'bonuses',
        'tollsReimbursed', 'distanceKm', 'tripsCount', 'trips',
        'fuelCost', 'fuelExpenses', 'commissionCost', 'otherExpenses',
        'netEarnings', 'hourlySegments', 'createdAt', 'updatedAt'
      ])
      && data.id is string
      && data.id.size() <= 120
      && data.platform in ['uber', 'bolt', 'freenow', 'other']
      && data.date is string
      && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && validTime(data.startTime)
      && validTime(data.endTime)
      && validNumber(data.totalHours, 0, 100)
      && validNumber(data.passengerHours, 0, 100)
      && validNumber(data.passengerDistanceKm, 0, 100000)
      && validNumber(data.emptyDistanceKm, 0, 100000)
      && validNumber(data.occupancyRatePct, 0, 100)
      && validNumber(data.grossEarnings, 0, 1000000)
      && validNumber(data.tips, 0, 1000000)
      && validNumber(data.bonuses, 0, 1000000)
      && validNumber(data.tollsReimbursed, 0, 1000000)
      && validNumber(data.distanceKm, 0, 100000)
      && validNumber(data.tripsCount, 0, 10000)
      && validNumber(data.fuelCost, 0, 1000000)
      && validNumber(data.commissionCost, 0, 1000000)
      && (!data.keys().hasAny(['commissionPct']) || validNumber(data.commissionPct, 0, 100))
      && (!data.keys().hasAny(['taxCost']) || validNumber(data.taxCost, 0, 1000000))
      && (!data.keys().hasAny(['taxPct']) || validNumber(data.taxPct, 0, 100))
      && validNumber(data.otherExpenses, 0, 1000000)
      && validNumber(data.netEarnings, -1000000, 1000000)
      && data.passengerHours <= data.totalHours
      && data.passengerDistanceKm <= data.distanceKm
      && data.emptyDistanceKm <= data.distanceKm - data.passengerDistanceKm + 0.01
      && data.trips is list
      && data.trips.size() <= 1000
      && data.fuelExpenses is list
      && data.fuelExpenses.size() <= 1000
      && data.hourlySegments is list
      && data.hourlySegments.size() <= 1000
      && data.createdAt is string
      && data.updatedAt is string
      && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 2000));
    }

    function validSettings(data) {
      return data.keys().hasOnly([
        'dailyGoal', 'weeklyGoal', 'defaultPlatform', 'enabledPlatforms',
        'fallbackHourlyRate', 'fallbackKmRate', 'movementThresholdSpeedKmh',
        'defaultCommissionPct', 'defaultTaxPct', 'soundEnabled', 'voiceEnabled',
        'aircraftSpeedometerEnabled', 'vehicleEnergy'
      ])
      && validNumber(data.dailyGoal, 0, 1000000)
      && validNumber(data.weeklyGoal, 0, 1000000)
      && validNumber(data.fallbackHourlyRate, 0, 10000)
      && validNumber(data.fallbackKmRate, 0, 10000)
      && validNumber(data.movementThresholdSpeedKmh, 0, 200)
      && (!data.keys().hasAny(['defaultCommissionPct']) || validNumber(data.defaultCommissionPct, 0, 100))
      && (!data.keys().hasAny(['defaultTaxPct']) || validNumber(data.defaultTaxPct, 0, 100))
      && data.defaultPlatform in ['all', 'uber', 'bolt', 'freenow', 'other']
      && data.enabledPlatforms is list
      && data.enabledPlatforms.size() <= 4
      && data.enabledPlatforms.hasOnly(['uber', 'bolt', 'freenow', 'other'])
      && data.soundEnabled is bool
      && data.voiceEnabled is bool
      && (!data.keys().hasAny(['aircraftSpeedometerEnabled']) || data.aircraftSpeedometerEnabled is bool)
      && data.vehicleEnergy is map
      && data.vehicleEnergy.keys().hasOnly(['vehicleType', 'vehicleModelName', 'consumptionPer100Km', 'fuelPricePerUnit', 'costPerKm'])
      && data.vehicleEnergy.vehicleType in ['electric', 'hybrid', 'diesel', 'petrol', 'lpg']
      && validNumber(data.vehicleEnergy.consumptionPer100Km, 0.001, 1000)
      && validNumber(data.vehicleEnergy.fuelPricePerUnit, 0.001, 100000)
      && validNumber(data.vehicleEnergy.costPerKm, 0.0001, 10000)
      && (!data.vehicleEnergy.keys().hasAny(['vehicleModelName']) || (data.vehicleEnergy.vehicleModelName is string && data.vehicleEnergy.vehicleModelName.size() <= 120));
    }

    function validActiveShift(data) {
      return data.keys().hasOnly(['session', 'updatedAt', 'originDeviceId', 'revision'])
        && data.keys().hasAll(['session', 'updatedAt'])
        && data.updatedAt is string
        && data.updatedAt.size() <= 50
        && (!data.keys().hasAny(['originDeviceId']) || (data.originDeviceId is string && data.originDeviceId.size() <= 120))
        && (!data.keys().hasAny(['revision']) || validNumber(data.revision, 0, 1000000000))
        && data.session is map
        && data.session.keys().hasOnly([
          'id', 'originDeviceId', 'state', 'drivingStatus', 'hasPassenger', 'currentTripPlatform',
          'platformTripsCount', 'trackingMode', 'platform', 'startTime',
          'activeDurationSeconds', 'passengerDurationSeconds', 'emptyDurationSeconds',
          'movingDurationSeconds', 'totalDistanceKm', 'passengerDistanceKm',
          'emptyDistanceKm', 'tripsCompletedCount', 'currentSpeedKmh',
          'currentPosition', 'pathHistory', 'currentTripPath',
          'currentTripStartedAt', 'currentTripStartDistanceKm',
          'currentTripStartEarnings', 'currentTripDurationSeconds', 'revision', 'trips',
          'estimatedEarnings', 'estimatedFuelCost', 'fuelExpenses', 'pendingRouteGaps',
          'estimatedNetEarnings', 'effectiveHourlyRate'
        ])
        && data.session.keys().hasAll([
          'id', 'state', 'drivingStatus', 'hasPassenger', 'currentTripPlatform',
          'platformTripsCount', 'trackingMode', 'platform', 'startTime',
          'activeDurationSeconds', 'passengerDurationSeconds', 'emptyDistanceKm',
          'emptyDurationSeconds', 'movingDurationSeconds', 'totalDistanceKm',
          'passengerDistanceKm', 'tripsCompletedCount', 'currentSpeedKmh',
          'currentPosition', 'pathHistory', 'currentTripPath',
          'currentTripStartedAt', 'currentTripStartDistanceKm',
          'currentTripStartEarnings', 'currentTripDurationSeconds', 'trips',
          'estimatedEarnings', 'estimatedFuelCost', 'fuelExpenses',
          'estimatedNetEarnings', 'effectiveHourlyRate'
        ])
        && data.session.id is string
        && data.session.id.size() <= 120
        && (!data.session.keys().hasAny(['originDeviceId']) || (data.session.originDeviceId is string && data.session.originDeviceId.size() <= 120))
        && data.session.state in ['active', 'paused']
        && data.session.drivingStatus in ['moving', 'stopped']
        && data.session.hasPassenger is bool
        && (data.session.currentTripPlatform == null || data.session.currentTripPlatform in ['uber', 'bolt', 'freenow', 'other'])
        && data.session.platformTripsCount is map
        && data.session.platformTripsCount.keys().hasOnly(['uber', 'bolt', 'freenow', 'other'])
        && data.session.trackingMode in ['real_gps', 'joystick']
        && data.session.platform in ['all', 'uber', 'bolt', 'freenow', 'other']
        && (data.session.startTime == null || validNumber(data.session.startTime, 0, 9999999999999))
        && validNumber(data.session.activeDurationSeconds, 0, 315360000)
        && validNumber(data.session.passengerDurationSeconds, 0, 315360000)
        && validNumber(data.session.emptyDurationSeconds, 0, 315360000)
        && validNumber(data.session.movingDurationSeconds, 0, 315360000)
        && validNumber(data.session.totalDistanceKm, 0, 10000000)
        && validNumber(data.session.passengerDistanceKm, 0, 10000000)
        && validNumber(data.session.emptyDistanceKm, 0, 10000000)
        && validNumber(data.session.tripsCompletedCount, 0, 10000)
        && validNumber(data.session.currentSpeedKmh, 0, 240)
        && validNumber(data.session.currentTripStartedAt, 0, 9999999999999)
        && validNumber(data.session.currentTripStartDistanceKm, 0, 10000000)
        && validNumber(data.session.currentTripStartEarnings, 0, 1000000)
        && validNumber(data.session.currentTripDurationSeconds, 0, 315360000)
        && (!data.session.keys().hasAny(['revision']) || validNumber(data.session.revision, 0, 1000000000))
        && validNumber(data.session.estimatedEarnings, 0, 1000000)
        && validNumber(data.session.estimatedFuelCost, 0, 1000000)
        && validNumber(data.session.estimatedNetEarnings, -1000000, 1000000)
        && validNumber(data.session.effectiveHourlyRate, -1000000, 1000000)
        && data.session.passengerDurationSeconds <= data.session.activeDurationSeconds
        && data.session.passengerDistanceKm <= data.session.totalDistanceKm
        && data.session.emptyDistanceKm <= data.session.totalDistanceKm - data.session.passengerDistanceKm + 0.01
        && data.session.currentPosition is map
        && data.session.currentPosition.keys().hasOnly(['lat', 'lng', 'heading', 'accuracy'])
        && validNumber(data.session.currentPosition.lat, -90, 90)
        && validNumber(data.session.currentPosition.lng, -180, 180)
        && validNumber(data.session.currentPosition.heading, 0, 360)
        && validNumber(data.session.currentPosition.accuracy, 0, 10000)
        && data.session.pathHistory is list
        && data.session.pathHistory.size() <= 2000
        && data.session.currentTripPath is list
        && data.session.currentTripPath.size() <= 2000
        && data.session.trips is list
        && data.session.trips.size() <= 100
        && data.session.fuelExpenses is list
        && data.session.fuelExpenses.size() <= 100
        // Compatível com sessões antigas: clientes novos enviam a lista;
        // clientes antigos continuam válidos até serem atualizados.
        && (!data.session.keys().hasAny(['pendingRouteGaps'])
          || (data.session.pendingRouteGaps is list && data.session.pendingRouteGaps.size() <= 1000));
    }

    match /users/{userId}/driverwise_records/{recordId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.id == recordId
        && validRecord(request.resource.data);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/settings/config {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validSettings(request.resource.data);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/active_shift/current {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validActiveShift(request.resource.data);
      allow delete: if signedInAs(userId);
    }

    match /users/{userId}/session/{document=**} {
      allow read, write: if false;
    }

    // Legacy collections are available only to the administrative migration tool.
    match /driverwise_records/{recordId} {
      allow read, write: if false;
    }

    match /driverwise_settings/{userId} {
      allow read, write: if false;
    }

    
    match /controle_mental_tasks/{taskId} {
      allow read, write: if true;
    }
    match /controle_mental_responses/{responseId} {
      allow read, write: if true;
    }
    match /controle_mental_workspaces/{workspaceId} {
      allow read, write: if true;
    }
    match /controle_mental_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /controle_mental_codex_workspaces/{workspaceId} {
      allow read, write: if true;
    }
    match /controle_mental_codex_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /controle_mental_codex_models/{modelId} {
      allow read, write: if true;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
